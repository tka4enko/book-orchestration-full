# Debug Reporter Configuration
# Copy these to your .env file to enable debug reporting

# Enable/disable debug reporting system
DEBUG_REPORTER_ENABLED=true

# Enable LLM analysis of debug sessions (requires OPENAI_API_KEY)
DEBUG_LLM_ANALYSIS=true

# Example usage:
# 1. Copy these settings to your .env file
# 2. Restart your application
# 3. Debug reports will appear after each query
# 4. To disable: set DEBUG_REPORTER_ENABLED=false